# Copy to .env and fill in. .env is gitignored — never commit real keys.
GEMINI_API_KEY=
ANTHROPIC_API_KEY=            # only for --rerun-agent claude-code
CLAUDE_CODE_OAUTH_TOKEN=      # alternative to ANTHROPIC_API_KEY (from `claude setup-token`)
TIGER_DATABASE_URL=
GEMINI_CLI_TRUST_WORKSPACE=true
